POSTGRES_DB=genesisit
POSTGRES_USER=genesisit
POSTGRES_PASSWORD=replace-with-a-long-random-secret
GENESIS_ADMIN_USERNAME=Admin
GENESIS_ADMIN_PASSWORD=temporary-bootstrap-password
GENESIS_COOKIE_SECURE=true
REMOTEIT_PUBLIC_URL=https://supportgenesis.ru
# Generate once with at least 32 random characters. Changing it after agents
# have pinned the public key intentionally blocks signed Action Jobs.
REMOTEIT_ACTION_SIGNING_SECRET=replace-with-a-long-random-secret
# Необязательно: расширенное объяснение AI. Ключ хранится только на сервере.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
