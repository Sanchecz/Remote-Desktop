{
  "name": "remoteit-web",
  "private": true,
  "version": "1.0.26",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
		"test": "pnpm run test:keyboard && pnpm run test:camera && pnpm run test:frames && pnpm run test:pointer && pnpm run test:input && pnpm run test:viewport && pnpm run test:reconnect && pnpm run test:files && pnpm run test:codex",
    "test:keyboard": "node --experimental-strip-types --test tests/remoteKeyboard.test.ts",
    "test:camera": "node --experimental-strip-types --test tests/remoteCamera.test.ts",
		"test:frames": "node --experimental-strip-types --test tests/remoteFramePresentation.test.ts",
		"test:pointer": "node --experimental-strip-types --test tests/remotePointerCadence.test.ts",
		"test:input": "node --experimental-strip-types --test tests/remoteInputDelivery.test.ts",
    "test:viewport": "node --experimental-strip-types --test tests/remoteViewport.test.ts",
    "test:reconnect": "node --experimental-strip-types --test tests/remoteReconnect.test.ts",
    "test:files": "node --experimental-strip-types --test tests/fileTransfers.test.ts",
    "test:codex": "node --experimental-strip-types --test tests/codexSetup.test.ts",
    "check": "pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "lucide-react": "1.29.0",
    "vite": "8.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2"
  }
}
